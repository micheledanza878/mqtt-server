# Salva i dati su disco così non perdi i messaggi al riavvio
persistence true
persistence_location /mosquitto/data/

# Registra cosa succede (utile per il debug)
log_dest file /mosquitto/log/mosquitto.log
log_dest stdout

# --- CONFIGURAZIONE RETE ---
# Ascolta sulla porta 1883 (standard MQTT)
listener 1883 0.0.0.0

# Permetti connessioni senza password per i test iniziali
# (In produzione dovrai mettere 'false' e creare un file password)
allow_anonymous true